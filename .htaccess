Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. Prevent 301 redirects on POST requests (Preserves login data)
RewriteCond %{REQUEST_METHOD} !POST

# 2. Redirect GET requests from /page.php to /page in the address bar
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Internally map clean URLs back to .php files behind the scenes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.*)$ $1.php [L]