Options -MultiViews
RewriteEngine On

# 1. Redirect GET/HEAD requests from /page.php to /page (POST is left alone to preserve form data)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s(/[^\s?]*)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Internally map clean URLs back to .php files (works from any folder, e.g. /yesparency/ or the web root)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
